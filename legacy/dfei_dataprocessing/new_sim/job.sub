executable = run.sh
output     = logs/bkg_$(Process).out
error      = logs/bkg_$(Process).err
log        = logs/job.log
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = gen, decfiles.tar.gz, DECAY.DEC, evt.pdl
+JobFlavour = "testmatch"

arguments = $(args)
queue args from (
  "-D decfiles/Bs_Jpsiphi.dec -f 0 -n 40000"
  #"-D decfiles/Bs_Jpsiphi.dec -f 40000 -n 40000"
  #"-D decfiles/Bd_JpsiKs.dec -f 0 -n 40000"
  #"-D decfiles/Bd_JpsiKs.dec -f 40000 -n 40000"
  #"-D decfiles/Bs_Dspi.dec -f 0 -n 40000"
  #"-D decfiles/Bs_Dspi.dec -f 40000 -n 40000"
  #"-D decfiles/Bd_Dpi.dec -f 0 -n 40000"
  #"-D decfiles/Bd_Dpi.dec -f 40000 -n 40000"
  #"-f 0 -n 40000 --inclusive"
  #"-f 40000 -n 40000 --inclusive"
  #"-f 80000 -n 40000 --inclusive"
  #"-f 120000 -n 40000 --inclusive"
  #"-f 160000 -n 40000 --inclusive"
  #"-f 0 -n 10000000 --background"
  "-f 0 -n 400000 --background"
)

